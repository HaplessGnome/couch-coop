{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.couchcoop.fabric.CouchCoopFabric"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "breaks": {
    "controlify": "*"
  },
  "conflicts": {
    "splitscreen": "*"
  }
}
